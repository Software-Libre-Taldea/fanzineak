        <PAGEOBJECT XPOS="213.38915389837" YPOS="3677.94495412844" OwnPage="7" ItemID="858269779" PTYPE="4" WIDTH="113.071915937015" HEIGHT="20.2748768726126" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L113.072 0 L113.072 20.2749 L0 20.2749 L0 0 Z" copath="M0 0 L113.072 0 L113.072 20.2749 L0 20.2749 L0 0 Z" gXpos="213.38915389837" gYpos="3677.94495412844" gWidth="113.071915937015" gHeight="20.2748768726126" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
