            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Software libreak aurrera bultzatuko zaitu gaur, baina ingurumenak ez dizu erritmoa segituko. Zure gaurko kolorea #0000FF da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.036697247706" YPOS="3817.37246755946" OwnPage="7" ItemID="60341846" PTYPE="4" WIDTH="515.119266055046" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.119 0 L515.119 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L515.119 0 L515.119 81.0669 L0 81.0669 L0 0 Z" gXpos="140.036697247706" gYpos="3817.37246755946" gWidth="498.412377806005" gHeight="81.066871873755" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Bash-eko one-line batek prozesu askotan lagunduko dizu gaur. Garrantzitsua da aginduak serialki tratatzea eta hari asko ez hastea. Zure gaurko kolorea #FFFF00 da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.036697247706" YPOS="3931.20549859636" OwnPage="7" ItemID="60232518" PTYPE="4" WIDTH="514.238532110092" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.239 0 L514.239 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L514.239 0 L514.239 81.0669 L0 81.0669 L0 0 Z" gXpos="140.036697247706" gYpos="3931.20549859636" gWidth="498.412377806005" gHeight="81.066871873755" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="CPU-a %100-ean izango duzu lanean. Garrantzitsua izango da prozesu kritikoei prioritatea ematea. Zure gaurko kolorea #30D5C8 da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.706422018349" YPOS="4045.03852963326" OwnPage="7" ItemID="60354806" PTYPE="4" WIDTH="515.889908256881" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.89 0 L515.89 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L515.89 0 L515.89 81.0669 L0 81.0669 L0 0 Z" gXpos="139.706422018349" gYpos="4045.03852963326" gWidth="498.412377806005" gHeight="81.066871873755" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Memoria kudeaketa manuala erabili nahiko duzu, baina hobe duzu garbage-collector-a erabiltzea. Zure gaurko kolorea #FF0000 da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.706422018349" YPOS="4152.40284938293" OwnPage="7" ItemID="60422566" PTYPE="4" WIDTH="514.56880733945" HEIGHT="81.066835439085" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.569 0 L514.569 81.0668 L0 81.0668 L0 0 Z" copath="M0 0 L514.569 0 L514.569 81.0668 L0 81.0668 L0 0 Z" gXpos="139.706422018349" gYpos="4152.40284938293" gWidth="498.411981450548" gHeight="81.066835439085" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Egun gogorra duzu gaur aurretik, bateria-aurrezlea alde batera utzi eta aurre egin zure lanei. Zure gaurko kolorea #FFA500 da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
