        </PAGEOBJECT>
        <PAGEOBJECT XPOS="786.192660550459" YPOS="3285.96330275229" OwnPage="6" ItemID="849726355" PTYPE="2" WIDTH="435.503583715596" HEIGHT="223.752293577982" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.437016198394496" LOCALSCY="0.437016198394496" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="android.png" IRENDER="0" EMBEDDED="0" path="M0 0 L435.504 0 L435.504 223.752 L0 223.752 L0 0 Z" copath="M0 0 L435.504 0 L435.504 223.752 L0 223.752 L0 0 Z" gXpos="786.192660550459" gYpos="3285.96330275229" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="735.036697247707" YPOS="2816.35253901695" OwnPage="6" ItemID="852985955" PTYPE="4" WIDTH="243.963" HEIGHT="657.773335108924" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L243.963 0 L243.963 657.773 L0 657.773 L0 0 Z" copath="M0 0 L243.963 0 L243.963 657.773 L0 657.773 L0 0 Z" gXpos="735.036697247707" gYpos="2816.35253901695" gWidth="243.963" gHeight="651.273149056444" ALIGN="3" LAYER="0" NEXTITEM="852901187" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" LINESPMode="1" FONTSIZE="13.5" BASEO="0"/>
                <ITEXT CH="2027tik aurrera, Googlek Play Storekoak ez diren aplikazioak blokeatu nahi ditu Android mugikor guztietan. Hau da, Androidek betidanik eskaini duen askatasun hori mugatu nahi dute, bakarrik Googleren baldintzekin ados dauden aplikazioak instalatu ahal izateko."/>
                <para PARENT="New Style"/>
                <ITEXT CH="Eguneraketa automatiko hori aktibatzen den egunetik aurrera, garatzaileek derrigorrez NANa aurkeztu eta 25€ ordaindu beharko dizkiote Googleri aplikazioak ebaluatzeko aukera izateko, eta enpresa honek aukeratutako aplikazioak bakarrik ahalko dira argitaratu bere dendan, zure mugikorrean ezingo duzu beste ezer instalatu."/>
                <para PARENT="New Style"/>
                <ITEXT CH="Berri hauek txarrak dira guztiontzat. Bai garatzaileentzat, bai Europaren subiranotasunarentzat (nola utziko diogu enpresa Estatubatuar bati erabakitzen zein aplikazio erabili daitezkeen hemen?), eta, noski, erabiltzaileontzat."/>
                <para PARENT="New Style"/>
                <ITEXT CH="Googlerekin ados ez dauden garatzaileek ezingo dituzte aplikazioak garatu Androidentzat, eta, hala, proiektu independente askok ezingo dute aurrera jarraitu. Ondorioz, erabiltzaileok aukera gutxiago izango ditugu gure mugikorrean izan nahi ditugun aplikazioak hautatzeko."/>
                <para PARENT="New Style"/>
                <ITEXT CH="Baina, zer dela eta hau dena? Googlek sinestarazi nahi digunaren arabera, neurri hauek Android duten mugikorrak seguruagoak izateko omen dira, aplikazio ofizialak bakarrik egongo direlako bere Play Store dendan. Hau, ordea, ez da oso sinesgarria; urteetan zehar artikulu asko atera dira Play Store bertan malwarea dagoela erakutsiz, kasu batzuetan milioika deskargekin."/>
                <para PARENT="New Style"/>
                <ITEXT CH="Benetako intentzioak nahiko argi ikusten direla esan genezake, Googlek garatzaileen dirua nahi izateaz gain, haien identitateak jakin nahi dituzte hauek ezin izateko Googleren interesen aurkako aplikazioak garatu. Adibidez, Newpipe aplikazioak YouTubeko bideoak ikusten uzten dizu Googleren jarraipenik edo iragarkirik gabe, eta noski, honen garatzaileak anonimoak dira. Hauek NANa aurkezten badute, ziurrenik arazo legaletan sartuko dira, beraz, neurri hauen aurka jarri dira."/>
                <para PARENT="New Style"/>
            </StoryText>
        </PAGEOBJECT>
