            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="736.433027522936" YPOS="3617.1875150185" OwnPage="8" ItemID="860962819" PTYPE="4" WIDTH="514.349" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.349 0 L514.349 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L514.349 0 L514.349 92.0986 L0 92.0986 L0 0 Z" gXpos="736.433027522936" gYpos="3617.1875150185" gWidth="514.349" gHeight="92.0986222196283" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Gaur zure sare pila bereziki pozik dago, momentu hona da TCP konexioak irekitzeko sare lokalean. Jende berriarekin handshakeak eta  acknowledge seinaleak bidaltzeko oso oso garai ona duzu. Zure gaurko kolorea #000DFF da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="736.036697247706" YPOS="3746.51113935325" OwnPage="8" ItemID="861069203" PTYPE="4" WIDTH="515.119" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.119 0 L515.119 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L515.119 0 L515.119 92.0986 L0 92.0986 L0 0 Z" gXpos="736.036697247706" gYpos="3746.51113935325" gWidth="515.119" gHeight="92.0986222196283" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Gaur planifikatzaile esnatu zara eta aginduak birrordenatu nahi dituzu. Egun ona duzu horretarako.  Lehentasunak zein diren identifikatu behar dituzu, zure bizitzari ordena eman nahi badiozu. Eta garbitu ordenagailuko mahaigaina ere, bada garaia, kotxin@. Zure gaurko kolorea #FF00DD da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="736.036697247706" YPOS="3875.834763688" OwnPage="8" ItemID="860951955" PTYPE="4" WIDTH="514.239" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.239 0 L514.239 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L514.239 0 L514.239 92.0986 L0 92.0986 L0 0 Z" gXpos="736.036697247706" gYpos="3875.834763688" gWidth="514.239" gHeight="92.0986222196283" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Aspaldian lanean dabilen prozesu bat amaituko da, eta horrek uste zenuena baino errekutso gehiago askatuko ditu. Ez zinen gogoratzen GPUa %90 baino gutxiago lanean izatea zer zen, baina oraintxe RAM guztia libratuko da. Ez sartu beste prozesurik, tarte batean, bederen. Zure gaurko kolorea #C8FF00 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="735.706422018349" YPOS="4005.15838802275" OwnPage="8" ItemID="861052867" PTYPE="4" WIDTH="515.89" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.89 0 L515.89 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L515.89 0 L515.89 92.0986 L0 92.0986 L0 0 Z" gXpos="735.706422018349" gYpos="4005.15838802275" gWidth="515.89" gHeight="92.0986222196283" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Zure prozesuen prioritatea handia izango da gaur, aprobetxatu kalkuluei etekin handia ateratzeko. Ez dakizu oso ondo zergatik, baina CPUaren tenperatura ez da 50º tik igotzen ari. Aprobetxatu lasaitasun hori. Zure gaurko kolorea #FF33EE da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="735.706422018349" YPOS="4127.13302778931" OwnPage="8" ItemID="861098163" PTYPE="4" WIDTH="514.569" HEIGHT="92.0985086114575" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.569 0 L514.569 92.0985 L0 92.0985 L0 0 Z" copath="M0 0 L514.569 0 L514.569 92.0985 L0 92.0985 L0 0 Z" gXpos="735.706422018349" gYpos="4127.13302778931" gWidth="514.569" gHeight="92.0985086114575" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Gaur sare lokala bereziki libre izango duzu inguruan, momentua da broadcast asko egiteko. Ez ahaztu zure lagunak eta prozesuak, eta ireki socketa aspaldian ikusi ez duzun pertsona horrekin. Broadcast, broadcast, broadcast... Zure gaurko kolorea #D3FF0F da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="735.926605504587" YPOS="4256.45665212406" OwnPage="8" ItemID="861145955" PTYPE="4" WIDTH="513.908" HEIGHT="92.0985086114574" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L513.908 0 L513.908 92.0985 L0 92.0985 L0 0 Z" copath="M0 0 L513.908 0 L513.908 92.0985 L0 92.0985 L0 0 Z" gXpos="735.926605504587" gYpos="4256.45665212406" gWidth="513.908" gHeight="92.0985086114574" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Gaur bateria %100-ean izango duzu, momentua da GPU-ak behar dituen lanak egiten uzteko. Esperimentuak egiteko oso garai ona da, bizitzaren zentzu guztietan. Ez itxi ateak FP16 kalkuluak egiteari, inoiz egin ez badituzu. Zure gaurko kolorea #008000 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1083.38915389837" YPOS="3716.4873247546" OwnPage="8" ItemID="861331827" PTYPE="4" WIDTH="113.072" HEIGHT="23.0339430228705" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L113.072 0 L113.072 23.0339 L0 23.0339 L0 0 Z" copath="M0 0 L113.072 0 L113.072 23.0339 L0 23.0339 L0 0 Z" gXpos="1083.38915389837" gYpos="3716.4873247546" gWidth="113.072" gHeight="23.0339430228705" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" FONT="Futura Extra Bold" FONTSIZE="16"/>
                <ITEXT FONT="Futura Extra Bold" FONTSIZE="16" CH="Escorpius"/>
                <trail ALIGN="1"/>
