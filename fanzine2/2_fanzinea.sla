        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.433027522936" YPOS="3703.53943652256" OwnPage="7" ItemID="858378371" PTYPE="4" WIDTH="514.348623853211" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.349 0 L514.349 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L514.349 0 L514.349 81.0669 L0 81.0669 L0 0 Z" gXpos="140.433027522936" gYpos="3703.53943652256" gWidth="498.412377806005" gHeight="81.066871873755" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Software libreak aurrera bultzatuko zaitu gaur, egunero egiten duen bezala. Ez ahaztu nor dagoen beti zure alboan: onartu bere laguntza eta lagundu zuk ere, ahal duzunean, Jesukristok esan zuen bezala. Erabili, kontribuitu eta gozatu. Zure gaurko kolorea #0000FF da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.036697247706" YPOS="3817.37246755946" OwnPage="7" ItemID="860545539" PTYPE="4" WIDTH="515.119266055046" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.119 0 L515.119 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L515.119 0 L515.119 81.0669 L0 81.0669 L0 0 Z" gXpos="140.036697247706" gYpos="3817.37246755946" gWidth="498.412377806005" gHeight="81.066871873755" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Bash-eko one-line batek prozesu askotan lagunduko dizu gaur. Garrantzitsua da aginduak serialki tratatzea eta hari asko ez hastea. Alegia, ez sartu ur handiegitan, ez bazaude seguru zer egiten ari zaren. Zure gaurko kolorea #FFFF00 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="140.036697247706" YPOS="3931.20549859636" OwnPage="7" ItemID="860422883" PTYPE="4" WIDTH="514.238532110092" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.239 0 L514.239 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L514.239 0 L514.239 81.0669 L0 81.0669 L0 0 Z" gXpos="140.036697247706" gYpos="3931.20549859636" gWidth="498.412377806005" gHeight="81.066871873755" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="CPU-a %100-ean izango duzu lanean. Garrantzitsua izango da prozesu kritikoei prioritatea ematea. Utzi prozesu txikienak alde batera eta zentratu zaitez benetan axola dutenetan. Badakizu  zertaz ari naizen, ezta? Zure gaurko kolorea #30D5C8 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.706422018349" YPOS="4045.03852963326" OwnPage="7" ItemID="860529571" PTYPE="4" WIDTH="515.889908256881" HEIGHT="81.066871873755" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.89 0 L515.89 81.0669 L0 81.0669 L0 0 Z" copath="M0 0 L515.89 0 L515.89 81.0669 L0 81.0669 L0 0 Z" gXpos="139.706422018349" gYpos="4045.03852963326" gWidth="498.412377806005" gHeight="81.066871873755" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Memoria kudeaketa manuala erabili nahiko duzu, baina hobe duzu garbage-collector-a erabiltzea. Lan gehiegirekin zabiltza azkenaldian eta zaborra ateratzea ere buruan izan behar abduzu, lehertu egingo zara. Hobe da mundua gelditu, garbitu eta aurrera jarraitzea. Zure gaurko kolorea #FF0000 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.706422018349" YPOS="4152.40284938293" OwnPage="7" ItemID="860596803" PTYPE="4" WIDTH="514.56880733945" HEIGHT="81.066835439085" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.569 0 L514.569 81.0668 L0 81.0668 L0 0 Z" copath="M0 0 L514.569 0 L514.569 81.0668 L0 81.0668 L0 0 Z" gXpos="139.706422018349" gYpos="4152.40284938293" gWidth="498.411981450548" gHeight="81.066835439085" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Egun gogorra duzu gaur aurretik, bateria aurrezlea alde batera utzi eta aurre egin zure lanei. Programatzaileen sekretu handiena kafe hutsa dela esan ohi da, hartu bat, gaur hartu ez baduzu, eta bestela hartu bigarrena. Zure gaurko kolorea #FFA500 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="139.926605504587" YPOS="4266.23588041982" OwnPage="7" ItemID="860627795" PTYPE="4" WIDTH="513.908256880734" HEIGHT="81.0668354390849" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L513.908 0 L513.908 81.0668 L0 81.0668 L0 0 Z" copath="M0 0 L513.908 0 L513.908 81.0668 L0 81.0668 L0 0 Z" gXpos="139.926605504587" gYpos="4266.23588041982" gWidth="498.411981450548" gHeight="81.0668354390849" ALIGN="3" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="3" FONTSIZE="15"/>
                <ITEXT FONTSIZE="15" CH="Energia digitala zure alde duzu gaur. Momentu ona da sekzio kritikoak hartzeko. Talde lana ona da, baina aldagai partekatuak batera ukitzen hasten bazarete, pikutara joango zaizue dena. Zure gaurko kolorea #735548 da."/>
                <trail ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="487.38915389837" YPOS="3790.94495412844" OwnPage="7" ItemID="860803187" PTYPE="4" WIDTH="113.071915937015" HEIGHT="20.2748768726126" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L113.072 0 L113.072 20.2749 L0 20.2749 L0 0 Z" copath="M0 0 L113.072 0 L113.072 20.2749 L0 20.2749 L0 0 Z" gXpos="487.38915389837" gYpos="3790.94495412844" gWidth="113.071915937015" gHeight="20.2748768726126" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
