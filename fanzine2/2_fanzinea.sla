        <PAGEOBJECT XPOS="809.38915389837" YPOS="3588.11009174312" OwnPage="8" ItemID="860990723" PTYPE="4" WIDTH="113.072" HEIGHT="23.0339430228705" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L113.072 0 L113.072 23.0339 L0 23.0339 L0 0 Z" copath="M0 0 L113.072 0 L113.072 23.0339 L0 23.0339 L0 0 Z" gXpos="809.38915389837" gYpos="3588.11009174312" gWidth="113.072" gHeight="23.0339430228705" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
