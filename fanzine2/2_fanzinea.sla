        <PAGEOBJECT XPOS="735.036697247706" YPOS="2706.20917431193" OwnPage="6" ItemID="848826099" PTYPE="4" WIDTH="515.449541284404" HEIGHT="84.0220183486239" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.45 0 L515.45 84.022 L0 84.022 L0 0 Z" copath="M0 0 L515.45 0 L515.45 84.022 L0 84.022 L0 0 Z" gXpos="735.036697247706" gYpos="2706.20917431193" gWidth="0" gHeight="0" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
