        <PAGEOBJECT XPOS="736.433027522936" YPOS="3617.1875150185" OwnPage="8" ItemID="60769414" PTYPE="4" WIDTH="514.349" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.349 0 L514.349 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L514.349 0 L514.349 92.0986 L0 92.0986 L0 0 Z" gXpos="736.433027522936" gYpos="3617.1875150185" gWidth="514.349" gHeight="92.0986222196283" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Gaur zure sare pila espezialki pozik dago, momentu hona da TCP konexioak irekitzeko sare lokalean. Zure gaurko kolorea #000DFF da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="736.036697247706" YPOS="3746.51113935325" OwnPage="8" ItemID="60827638" PTYPE="4" WIDTH="515.119" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.119 0 L515.119 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L515.119 0 L515.119 92.0986 L0 92.0986 L0 0 Z" gXpos="736.036697247706" gYpos="3746.51113935325" gWidth="515.119" gHeight="92.0986222196283" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Gaur planifikatzaile esnatu zara eta aginduak birrantolatu nahi dituzu. Egun ona duzu horretarako. Zure gaurko kolorea #FF00DD da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="736.036697247706" YPOS="3875.834763688" OwnPage="8" ItemID="60879350" PTYPE="4" WIDTH="514.239" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L514.239 0 L514.239 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L514.239 0 L514.239 92.0986 L0 92.0986 L0 0 Z" gXpos="736.036697247706" gYpos="3875.834763688" gWidth="514.239" gHeight="92.0986222196283" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Aspaldian lanean dabilen prozesu bat amaituko da, eta horrek uste zenuena baino errekutso gehiago askatuko ditu. Zure gaurko kolorea #C8FF00 da."/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="735.706422018349" YPOS="4005.15838802275" OwnPage="8" ItemID="60848550" PTYPE="4" WIDTH="515.89" HEIGHT="92.0986222196283" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L515.89 0 L515.89 92.0986 L0 92.0986 L0 0 Z" copath="M0 0 L515.89 0 L515.89 92.0986 L0 92.0986 L0 0 Z" gXpos="735.706422018349" gYpos="4005.15838802275" gWidth="515.89" gHeight="92.0986222196283" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Zure prozesuen prioritatea handia izango da gaur, aprobetxatu kalkuluei etekin handia ateratzeko. Zure gaurko kolorea #FF33EE da."/>
                <trail/>
